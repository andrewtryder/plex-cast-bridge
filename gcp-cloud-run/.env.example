# Google Cloud Settings
GCP_PROJECT_ID=plex-cast-bridge-home
GCP_PUBSUB_TOPIC_ID=plex-commands

# OAuth Settings (Configured in Google Home Developer Console)
GOOGLE_CLIENT_ID=plex-google-home-client-id
GOOGLE_CLIENT_SECRET=change-me-to-a-secure-random-client-secret
ADMIN_PASSPHRASE=change-me-to-your-strong-linking-passphrase
OAUTH_SIGNING_SECRET=change-me-to-a-64-char-random-jwt-signing-secret

# Optional Webhook API Key (defaults to ADMIN_PASSPHRASE if omitted)
WEBHOOK_API_KEY=

# Target Speaker friendly name (optional default)
DEFAULT_SPEAKER_NAME=Living Room

# Catalog configuration path
CATALOG_PATH=catalog.json

# Local testing flag (bypasses Google Pub/Sub authentication)
MOCK_PUBSUB=false

