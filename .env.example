# Optional when using Settings → Connect with Plex (JWT credentials under DATA_DIR).
# Still supported for existing installs / headless setup.
PLEX_URL=http://plex.local:32400
PLEX_TOKEN=
PLEX_MUSIC_SECTION=Music
DEFAULT_SPEAKER_NAME=Living Room
DEFAULT_SPEAKER_HOST=
DEFAULT_CAST_VOLUME=0.20
MAX_CAST_VOLUME=0.85
# NIGHT_CAST_VOLUME=0.15
GEMINI_API_KEY=
# Required for control API auth. Prefer the X-API-Key header; ?api_key= is deprecated.
# Generate with: openssl rand -hex 32
LOCAL_API_KEY=
# Set true only on a trusted LAN / local development host if you intentionally omit LOCAL_API_KEY.
ALLOW_UNAUTHENTICATED_LOCAL_API=false
# Mutable data (catalog.json, plex_connection.json, device keypair). Docker defaults to /data.
# DATA_DIR=
# Optional — only needed for Google Home voice via Pub/Sub
GCP_PROJECT_ID=
GCP_PUBSUB_SUBSCRIPTION_ID=
ENABLE_PUBSUB_LISTENER=false
# Outbound catalog sync to Cloud Run (after Google Home wizard)
# CLOUD_GATEWAY_URL=https://plex-google-home-fulfillment-….run.app
# CATALOG_WRITE_KEY=
